# ============================================================
# Solaz App — Python / CustomTkinter
# ============================================================

# --- 1. Temporários do Python ------------------------------
__pycache__/
*.py[cod]
venv/
.venv/

# --- 2. Banco de dados local, dados do usuário e credenciais
*.db
*.sqlite3
.env
# Token do bot do Telegram (o modelo segredos.example.py continua versionado):
segredos.py
# Criados em tempo de execução (config.py recria as pastas sozinho):
# banco, logos, assinaturas e fotos dos clientes.
data/

# --- 3. Compilação / executável (PyInstaller) --------------
build/
dist/
*.spec
# O .spec do build oficial fica versionado (inclui as bibliotecas do Supabase):
!SolazApp.spec
# Saída do Inno Setup (instaladores gerados):
Output/

# --- 4. Mídias e PDFs gerados em testes --------------------
*.pdf

# Imagens: só na raiz do projeto e em pastas de testes locais
# (assets/ continua versionado: logo_solaz.png e login_bg.png são do app)
/*.jpg
/*.jpeg
/*.png
/tests/**/*.jpg
/tests/**/*.jpeg
/tests/**/*.png
/testes/**/*.jpg
/testes/**/*.jpeg
/testes/**/*.png

# --- 5. Arquivos de diagnóstico ----------------------------
telegram_log.txt
*.log
*.log.*
login_prefs.json
estrutura.txt
ignorados.txt
